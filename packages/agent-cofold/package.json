{
  "name": "@ahpd/agent-cofold",
  "version": "0.13.0",
  "type": "module",
  "description": "An AHP backend over the cofold agent runtime: every model it can reach is a model inside one provider",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "protocol",
    "json-rpc",
    "backend",
    "adapter",
    "cofold",
    "openai",
    "openrouter",
    "ollama"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/agent-cofold#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/agent-cofold"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/agent-cofold/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.10 <1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "dependencies": {
    "@cofold/agents": "^0.4.0",
    "@cofold/commands": "^0.3.0",
    "@cofold/model-openai-compat": "^0.2.1",
    "@cofold/store-file": "^0.2.2",
    "@cofold/tools": "^0.4.1"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "title": "Cofold",
    "description": "Runs the Cofold agent runtime, providing access to OpenAI-compat api endpoints.",
    "categories": ["agent"],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "contracts": {
      "agents": ["*"]
    }
  }
}
