{
  "name": "@ahpd/tasks",
  "version": "0.13.0",
  "type": "module",
  "description": "Tasks and plans for the ahpd daemon: one list every agent reads and writes through host tools",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "plugin",
    "tasks",
    "plans",
    "kanban"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/tasks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/tasks"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/tasks/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.10 <1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*",
    "@cofold/agents": "^0.4.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "title": "Tasks",
    "options": {
      "requireApproval": { "required": false },
      "sweepAfterDays": { "required": false }
    }
  }
}
