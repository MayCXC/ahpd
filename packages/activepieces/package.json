{
  "name": "@ahpd/activepieces",
  "version": "0.13.0",
  "type": "module",
  "description": "Activepieces pieces as connectors for the ahpd daemon: each piece is an adapter, each action a host tool",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "plugin",
    "connector",
    "activepieces"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/activepieces#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/activepieces"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/activepieces/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.13 <1"
  },
  "dependencies": {
    "@activepieces/piece-resend": "0.6.1",
    "@activepieces/piece-slack": "0.23.1",
    "@activepieces/piece-telegram-bot": "0.9.1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "title": "Activepieces connectors",
    "description": "Each installed Activepieces piece is an adapter, and each of its actions is a host tool.",
    "categories": ["connector"],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "contracts": {
      "adapters": ["ap-*"]
    },
    "options": {
      "pieces": { "required": true }
    }
  }
}
