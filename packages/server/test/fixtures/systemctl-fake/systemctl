#!/bin/sh
# A stand-in for systemctl: says what it was asked, one argument per line, into
# the file SYSTEMCTL_LOG names, and then does what SYSTEMCTL_DO says. A case
# that wants the daemon the manager holds to go gives SYSTEMCTL_DO the signal
# to send it, which is the half of `systemctl stop` that matters here. The exit
# code is SYSTEMCTL_EXIT, so a case can have the manager refuse.

[ -n "$SYSTEMCTL_LOG" ] && for one in "$@"; do printf '%s\n' "$one" >> "$SYSTEMCTL_LOG"; done
[ -n "$SYSTEMCTL_DO" ] && sh -c "$SYSTEMCTL_DO"
exit "${SYSTEMCTL_EXIT:-0}"
