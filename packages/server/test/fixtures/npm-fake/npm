#!/bin/sh
# A stand-in for npm: waits when the caller says to, says one line, writes
# FAKE_NPM_STDERR to its standard error when set, and leaves the code the
# caller named. With FAKE_NPM_LOG set it appends a line to that
# file as it starts and as it ends, so a case can see whether two runs overlapped.
# With FAKE_NPM_LANDS set to "<name> <version>", an install writes that
# package's package.json under the --prefix directory's node_modules.
# An install of a plugin names its sources after a `--`; for each one the fake
# writes a package.json with an `ahpd` field and an `index.mjs` exporting the
# unscoped name, which is what npm really leaves and what the install path
# checks for. An update has no `--` and lands nothing, so a package it did not
# move stays at the version it had.

[ -n "$FAKE_NPM_LOG" ] && echo "start $*" >> "$FAKE_NPM_LOG"
[ -n "$FAKE_NPM_SLEEP" ] && sleep "$FAKE_NPM_SLEEP"
echo "npm noise"
if [ "$1" = install ] && [ "$2" = --prefix ]; then
  if [ -n "$FAKE_NPM_LANDS" ]; then
    dir="$3/node_modules/${FAKE_NPM_LANDS% *}"
    mkdir -p "$dir"
    printf '{"name":"%s","version":"%s"}\n' "${FAKE_NPM_LANDS% *}" "${FAKE_NPM_LANDS#* }" > "$dir/package.json"
  else
    source=''
    for arg do
      [ "$arg" = '--' ] && after=1 && continue
      [ -n "$after" ] && source="$arg"
    done
    case "$source" in
      @*/*@*) name=${source%@*}; version=${source##*@} ;;
      @*/*) name=$source; version=0.0.0 ;;
      *@*) name=${source%@*}; version=${source##*@} ;;
      *) name=$source; version=0.0.0 ;;
    esac
    case "$name" in
      ''|.*|/*|*:*) ;;
      *)
        mkdir -p "$3/node_modules/$name"
        printf '{"name":"%s","version":"%s","type":"module","main":"./index.mjs","ahpd":{"entry":"./index.mjs"}}\n' "$name" "$version" > "$3/node_modules/$name/package.json"
        printf "export const name = '%s';\nexport const apply = () => {};\n" "${name##*/}" > "$3/node_modules/$name/index.mjs"
        ;;
    esac
  fi
fi
[ -n "$FAKE_NPM_STDERR" ] && printf '%s\n' "$FAKE_NPM_STDERR" >&2
[ -n "$FAKE_NPM_LOG" ] && echo "end $*" >> "$FAKE_NPM_LOG"
exit "${FAKE_NPM_EXIT:-0}"
